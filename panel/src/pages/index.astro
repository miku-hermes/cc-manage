---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HeroCard from '../components/HeroCard.astro';
import KpiCard from '../components/KpiCard.astro';
import AccountCard from '../components/AccountCard.astro';
---
<Layout title="cc-manage · 额度面板" description="cc-manage 额度面板：Command Code 多账号反代网关的账号额度、可用性与请求 KPI 概览。">
<SiteHeader />

<main class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-4 py-2 2xl:max-w-[1600px]">
  <HeroCard />

  <!-- KPI 行：唯一模板在这里，render-hero.js 克隆它并按需隐藏零值卡 -->
  <section id="kpis" class="kpis stats stats-vertical w-full overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm lg:stats-horizontal"></section>

  <section id="filters" role="group" aria-label="状态筛选" class="filters join w-full"></section>

  <section id="cards" class="@container accounts grid grid-cols-1 gap-2 2xl:grid-cols-2 items-stretch [&.is-reflow>*]:animate-pulse"></section>
</main>

<!-- 账号行 / KPI 卡的唯一模板：render-cards.js、render-hero.js 克隆它们并用 [data-f] 填值 -->
<template id="tpl-account"><AccountCard /></template>
<template id="tpl-kpi"><KpiCard /></template>

<script src="js/utils.js" is:raw></script>
<script src="js/anim.js" is:raw></script>
<script src="js/api.js" is:raw></script>
<script src="js/state.js" is:raw></script>
<script src="js/theme.js" is:raw></script>
<script src="js/render-hero.js" is:raw></script>
<script src="js/render-cards.js" is:raw></script>
<script src="js/app.js" is:raw></script>
<script is:raw>
/* 引导块：外部脚本按依赖顺序加载（utils → api → state → render-* → app）。
   syncTagMasks 维护标签条渐隐状态；启动逻辑在 js/app.js 的 boot()。 */
function syncTagMasks() {
  for (const el of document.querySelectorAll('#cards .tags')) {
    const max = Math.max(0, (el.scrollWidth || 0) - (el.clientWidth || 0));
    const scrollable = max > 1;
    el.classList.toggle('is-scrollable', scrollable);
    el.classList.toggle('at-end', scrollable && (el.scrollLeft || 0) >= max - 1);
  }
}
/* 折叠行展开：把原生 <details> 的展开态同步到 aria-expanded（新增交互的可访问性契约）。 */
document.addEventListener('toggle', (e) => {
  const t = e.target;
  if (t && String(t.tagName).toUpperCase() === 'DETAILS' && t.querySelector('summary')) {
    const open = t.hasAttribute('open');
    const summary = t.querySelector('summary');
    summary.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
}, true);
$('cards').addEventListener('scroll', syncTagMasks, true);
/* 名称列 / 状态列统一宽度（syncNameColumn、syncStatusColumn 在 render-cards.js）：
   窗口尺寸 / 字体加载会改变文本像素宽，重算一次才能保持徽章起点与状态列左右边缘对齐。
   防抖，避免拖动窗口时反复重排。 */
let nameColTimer = null;
function scheduleNameColumn() {
  if (nameColTimer) clearTimeout(nameColTimer);
  nameColTimer = setTimeout(() => {
    if (typeof syncNameColumn === 'function') syncNameColumn();
    if (typeof syncStatusColumn === 'function') syncStatusColumn();
  }, 120);
}
addEventListener('resize', scheduleNameColumn);
if (document.fonts && document.fonts.ready) document.fonts.ready.then(scheduleNameColumn);
window.scheduleNameColumn = scheduleNameColumn;
window.state = state;
window.renderCards = renderCards;
window.syncTagMasks = syncTagMasks;
boot();
</script>
</Layout>
