---
/* 后台：登录门控 + 账号/客户端 key/管理员/运行日志四个管理区。
   视觉与 / 、/trend 同源：daisyUI（drawer + navbar + table + modal + badge + alert）+ Lucide。
   登录门控行为不变：仍是 showGate/showAdmin 切 display，apiJSON 见 401 回登录页。 */
import Layout from '../layouts/Layout.astro';
import AccountDetailModal from '../components/AccountDetailModal.astro';
import {
  Activity, Moon, Sun, LogOut, ChevronLeft, Menu, Server, KeyRound, Users, ScrollText,
  Plus, RefreshCw, ShieldCheck, PlugZap, Pencil, Trash2, Copy, Lock, CircleAlert, Eye, X,
} from '@lucide/astro';
---
<Layout title="cc-manage · 后台" description="cc-manage 后台：管理 Command Code 账号、API 客户端 key 与管理员账号。">

<div class="header navbar sticky top-0 z-40 min-h-14 border-b border-base-300 bg-base-100/85 backdrop-blur-md" id="gate-head" style="display:none">
  <div class="navbar-start gap-2 px-2">
    <span class="logo text-primary" aria-hidden="true"><Activity size={22} /></span>
    <span class="brand-name text-lg font-bold tracking-tight">cc-manage</span>
    <span class="brand-sub text-sm text-base-content/60">后台</span>
  </div>
  <div class="navbar-end px-2">
    <button id="theme-gate" class="icon-btn btn btn-ghost btn-circle btn-sm" type="button" title="切换主题" aria-label="切换主题">
      <Moon class="ico-moon dark:hidden" size={18} /><Sun class="ico-sun hidden dark:block" size={18} />
    </button>
  </div>
</div>

<main class="gate-main flex min-h-screen items-center justify-center p-4" id="boot-loading">
  <section class="gate-card card w-full max-w-md rounded-[var(--radius-md)] border border-base-300 bg-base-100 shadow-[var(--shadow-card)]">
    <div class="card-body items-center gap-3">
      <span class="loading loading-spinner loading-lg text-primary" aria-hidden="true"></span>
      <div class="skeleton h-4 w-32"></div>
      <h1 class="text-lg font-semibold">加载中…</h1>
      <p class="sub text-sm text-base-content/60">正在确认登录状态…</p>
    </div>
  </section>
</main>

<main class="gate-main flex min-h-screen items-center justify-center p-4" id="gate-main" style="display:none">
  <section class="gate-card card w-full max-w-md rounded-[var(--radius-md)] border border-base-300 bg-base-100 shadow-[var(--shadow-card)]">
    <form id="gate-form" class="card-body gap-3" novalidate>
    <div class="gate-logo mx-auto text-primary" aria-hidden="true"><Lock size={28} /></div>
    <h1 id="gate-title" class="text-center text-xl font-semibold">加载中…</h1>
    <p class="sub text-center text-sm text-base-content/60" id="gate-sub"></p>
    <div class="field space-y-1">
      <label class="label text-sm" for="gate-user">用户名</label>
      <input id="gate-user" class="input input-bordered w-full" type="text" autocomplete="username" spellcheck="false" maxlength="64">
    </div>
    <div class="field space-y-1">
      <label class="label text-sm" for="gate-pass">密码</label>
      <input id="gate-pass" class="input input-bordered w-full" type="password" autocomplete="current-password" spellcheck="false">
    </div>
    <div class="field space-y-1" id="gate-pass2-field" style="display:none">
      <label class="label text-sm" for="gate-pass2">确认密码</label>
      <input id="gate-pass2" class="input input-bordered w-full" type="password" autocomplete="new-password" spellcheck="false">
    </div>
    <div class="gate-actions modal-action justify-between">
      <a class="nav-link btn btn-ghost btn-sm gap-1" href="/"><ChevronLeft size={15} />返回前台</a>
      <button class="btn btn-primary" type="button" id="gate-submit">登录</button>
    </div>
    <div class="gate-err alert alert-error hidden text-sm" id="gate-err" role="alert"></div>
    </form>
  </section>
</main>

<div class="drawer lg:drawer-open">
  <input id="admin-drawer" type="checkbox" class="drawer-toggle">

  <div class="drawer-content flex min-h-screen flex-col">
    <header class="header navbar sticky top-0 z-40 min-h-14 border-b border-base-300 bg-base-100/85 backdrop-blur-md" id="admin-head" style="display:none">
      <div class="navbar-start gap-1 px-2">
        <label for="admin-drawer" class="btn btn-ghost btn-circle btn-sm lg:hidden" aria-label="打开菜单"><Menu size={18} /></label>
        <span class="logo text-primary" aria-hidden="true"><Activity size={22} /></span>
        <span class="brand-name text-lg font-bold tracking-tight">cc-manage</span>
        <span class="brand-sub text-sm text-base-content/60">后台</span>
      </div>
      <div class="navbar-end gap-1 px-2">
        <span id="who" class="who text-sm text-base-content/70"></span>
        <a class="nav-link btn btn-ghost btn-sm gap-1" href="/"><ChevronLeft size={15} />返回前台</a>
        <button id="theme" class="icon-btn btn btn-ghost btn-circle btn-sm tooltip tooltip-bottom" type="button" data-tip="切换主题" title="切换主题" aria-label="切换主题">
          <Moon class="ico-moon dark:hidden" size={18} /><Sun class="ico-sun hidden dark:block" size={18} />
        </button>
        <button id="logout" class="btn btn-ghost btn-sm gap-1" type="button"><LogOut size={15} />退出</button>
      </div>
    </header>

    <main class="admin-main mx-auto flex w-full max-w-6xl flex-col gap-4 p-4 2xl:max-w-[1600px]" id="admin-main" style="display:none">
      <h1 class="sr-only">后台管理</h1>
      <div class="banner warn alert alert-warning hidden" id="public-note" role="status"></div>
      <div class="banner alert alert-error hidden" id="autherr" role="alert"></div>
      <div class="banner load-error alert alert-error hidden" id="load-error" role="alert">
        <span id="load-error-text"></span>
        <button class="btn btn-sm max-[820px]:min-h-9" type="button" id="load-retry">重试</button>
      </div>
      <p class="readonly text-sm text-base-content/60" id="readonly"></p>

      <section class="card border border-base-300 bg-base-100" id="sec-accounts">
        <div class="card-body gap-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="card-title text-base">CC 账号 <span class="badge badge-ghost" id="acc-count">0 个</span></h2>
            <button class="btn btn-primary btn-sm gap-1" type="button" id="add-account"><Plus size={15} />新增 CC key</button>
          </div>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead><tr><th>备注名</th><th>keyId / keyPrefix</th><th>额度</th><th>状态</th><th>操作</th></tr></thead>
              <tbody id="accounts"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100" id="sec-keys">
        <div class="card-body gap-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="card-title text-base">客户端 key <span class="badge badge-ghost" id="key-count">0 个</span></h2>
            <button class="btn btn-primary btn-sm gap-1" type="button" id="add-key"><Plus size={15} />生成新 key</button>
          </div>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead><tr><th>名称</th><th>keyId</th><th>keyPrefix</th><th>创建时间</th><th>操作</th></tr></thead>
              <tbody id="keys"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100" id="sec-users">
        <div class="card-body gap-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="card-title text-base">管理员 <span class="badge badge-ghost" id="user-count">0 个</span></h2>
            <button class="btn btn-primary btn-sm gap-1" type="button" id="add-user"><Plus size={15} />新增管理员</button>
          </div>
          <div class="overflow-x-auto">
            <table class="table table-sm">
              <thead><tr><th>用户名</th><th>创建时间</th><th>操作</th></tr></thead>
              <tbody id="users"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="card border border-base-300 bg-base-100" id="sec-events">
        <div class="card-body gap-3">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="card-title text-base">运行日志 <span class="badge badge-ghost" id="event-count">0 条</span></h2>
            <div class="join">
              <select id="level" class="select select-bordered select-sm join-item max-[820px]:min-h-9" aria-label="按级别过滤">
                <option value="">全部级别</option>
                <option value="info">info</option>
                <option value="warn">warn</option>
                <option value="error">error</option>
                <option value="debug">debug</option>
              </select>
              <button class="btn btn-sm join-item gap-1" type="button" id="reload-events"><RefreshCw size={14} />刷新</button>
            </div>
          </div>
          <div class="events divide-y divide-base-200" id="events" aria-live="polite"></div>
        </div>
      </section>
    </main>
  </div>

  <div class="drawer-side z-30">
    <label for="admin-drawer" class="drawer-overlay" aria-label="关闭菜单"></label>
    <aside class="menu min-h-full w-56 bg-base-100 p-3 text-base-content">
      <p class="menu-title flex items-center gap-2"><ShieldCheck size={15} />后台</p>
      <ul>
        <li><a href="#sec-accounts"><Server size={15} />CC 账号</a></li>
        <li><a href="#sec-keys"><KeyRound size={15} />客户端 key</a></li>
        <li><a href="#sec-users"><Users size={15} />管理员</a></li>
        <li><a href="#sec-events"><ScrollText size={15} />运行日志</a></li>
      </ul>
      <div class="divider"></div>
      <ul>
        <li><a href="/"><ChevronLeft size={15} />返回前台</a></li>
      </ul>
    </aside>
  </div>
</div>

<!-- 新增账号 -->
<div class="modal" id="m-account">
  <div class="modal-box dialog pop-in" role="dialog" aria-modal="true" aria-labelledby="m-account-title">
    <form class="space-y-3">
    <h3 id="m-account-title" class="text-lg font-semibold">新增账号</h3>
    <p class="sub text-sm text-base-content/60">CC key 只提交给本机服务端，不回显、不写进页面。</p>
    <div class="field space-y-1">
      <label class="label text-sm" for="a-name">备注名</label>
      <input id="a-name" class="input input-bordered w-full" type="text" placeholder="例如：主号" maxlength="64" autocomplete="off">
    </div>
    <div class="field space-y-1">
      <label class="label text-sm" for="a-key">CC key（明文只此一次）</label>
      <textarea id="a-key" class="textarea textarea-bordered w-full font-mono" rows="3" spellcheck="false" autocomplete="off"></textarea>
    </div>
    <div class="err-text text-sm text-error" id="a-err"></div>
    <div class="dialog-actions modal-action">
      <button class="btn" type="button" data-close="m-account">取消</button>
      <button class="btn btn-primary" type="submit" id="a-submit">创建</button>
    </div>
    </form>
  </div>
  <div class="modal-backdrop" data-close="m-account"></div>
</div>

<!-- 改备注 -->
<div class="modal" id="m-rename">
  <div class="modal-box dialog pop-in" role="dialog" aria-modal="true" aria-labelledby="m-rename-title">
    <form class="space-y-3">
    <h3 id="m-rename-title" class="text-lg font-semibold">修改备注</h3>
    <p class="sub text-sm text-base-content/60" id="r-sub"></p>
    <div class="field space-y-1">
      <label class="label text-sm" for="r-name">新名称</label>
      <input id="r-name" class="input input-bordered w-full" type="text" maxlength="64" autocomplete="off">
    </div>
    <div class="err-text text-sm text-error" id="r-err"></div>
    <div class="dialog-actions modal-action">
      <button class="btn" type="button" data-close="m-rename">取消</button>
      <button class="btn btn-primary" type="submit" id="r-submit">保存</button>
    </div>
    </form>
  </div>
  <div class="modal-backdrop" data-close="m-rename"></div>
</div>

<!-- 新增管理员 -->
<div class="modal" id="m-user">
  <div class="modal-box dialog pop-in" role="dialog" aria-modal="true" aria-labelledby="m-user-title">
    <form class="space-y-3">
    <h3 id="m-user-title" class="text-lg font-semibold">新增管理员</h3>
    <p class="sub text-sm text-base-content/60">密码用 scrypt 加盐哈希保存，文件里不含明文。</p>
    <div class="field space-y-1">
      <label class="label text-sm" for="u-name">用户名</label>
      <input id="u-name" class="input input-bordered w-full" type="text" placeholder="例如：admin" maxlength="64" autocomplete="off" spellcheck="false">
    </div>
    <div class="field space-y-1">
      <label class="label text-sm" for="u-pass">密码（至少 8 位）</label>
      <input id="u-pass" class="input input-bordered w-full" type="password" autocomplete="new-password" spellcheck="false">
    </div>
    <div class="err-text text-sm text-error" id="u-err"></div>
    <div class="dialog-actions modal-action">
      <button class="btn" type="button" data-close="m-user">取消</button>
      <button class="btn btn-primary" type="submit" id="u-submit">创建</button>
    </div>
    </form>
  </div>
  <div class="modal-backdrop" data-close="m-user"></div>
</div>

<!-- 修改密码 -->
<div class="modal" id="m-pass">
  <div class="modal-box dialog pop-in" role="dialog" aria-modal="true" aria-labelledby="m-pass-title">
    <form class="space-y-3">
    <h3 id="m-pass-title" class="text-lg font-semibold">修改密码</h3>
    <p class="sub text-sm text-base-content/60" id="p-sub"></p>
    <div class="field hidden space-y-1" id="p-current-field">
      <label class="label text-sm" for="p-current">当前管理员密码</label>
      <input id="p-current" class="input input-bordered w-full" type="password" autocomplete="current-password" spellcheck="false">
    </div>
    <div class="field space-y-1">
      <label class="label text-sm" for="p-pass">新密码（至少 8 位）</label>
      <input id="p-pass" class="input input-bordered w-full" type="password" autocomplete="new-password" spellcheck="false">
    </div>
    <div class="err-text text-sm text-error" id="p-err"></div>
    <div class="dialog-actions modal-action">
      <button class="btn" type="button" data-close="m-pass">取消</button>
      <button class="btn btn-primary" type="submit" id="p-submit">保存</button>
    </div>
    </form>
  </div>
  <div class="modal-backdrop" data-close="m-pass"></div>
</div>

<!-- 生成客户端 key -->
<div class="modal" id="m-newkey">
  <div class="modal-box dialog pop-in" role="dialog" aria-modal="true" aria-labelledby="m-newkey-title">
    <form class="space-y-3">
    <h3 id="m-newkey-title" class="text-lg font-semibold">生成新 key</h3>
    <p class="sub text-sm text-base-content/60">key 由服务端生成（sk-cg- + 32 字节随机），只显示一次。</p>
    <div id="k-form" class="space-y-3">
      <div class="field space-y-1">
        <label class="label text-sm" for="k-name">客户端名称</label>
        <input id="k-name" class="input input-bordered w-full" type="text" placeholder="例如：我的笔记本" maxlength="64" autocomplete="off">
      </div>
      <div class="err-text text-sm text-error" id="k-err"></div>
    </div>
    <div id="k-result" class="hidden">
      <div class="onetime alert alert-info">
        <div class="onetime-label">此 key 只显示一次，请立刻复制保存</div>
        <div class="onetime-value flex items-center gap-2">
          <code id="k-plain" class="mono code flex-1 break-all"></code>
          <button class="btn btn-sm gap-1" type="button" id="k-copy"><Copy size={14} />复制</button>
        </div>
      </div>
      <div class="err-text text-sm text-error" id="k-warn"></div>
    </div>
    <div class="dialog-actions modal-action">
      <button class="btn" type="button" data-close="m-newkey">关闭</button>
      <button class="btn btn-primary" type="submit" id="k-submit">生成</button>
    </div>
    </form>
  </div>
  <div class="modal-backdrop" data-close="m-newkey"></div>
</div>


<!-- ── B24：运行期行结构只在下面出现一次；render-*.js 只做「克隆 + 填值」，
     不再手拼 HTML 字符串（与前台 #tpl-account 同一套模式）。模板刻意压成单行，
     避免克隆出多余空白文本节点。 ── -->
<AccountDetailModal admin />
<template id="tpl-account-row"><tr><td data-label="备注名"><div class="cell-name font-medium" data-f="name"></div><div class="test-note text-xs" data-f="test-note"></div></td><td data-label="keyId / keyPrefix" class="mono cell-sub text-xs text-base-content/60"><span class="block" data-f="key-id"></span><span class="block" data-f="key-prefix"></span></td><td data-label="额度" class="cell-quota space-y-1"><div class="qbar flex items-center gap-2" data-f="bar-5h"><span class="qbar-label shrink-0 text-xs text-base-content/60">5h</span><progress class="progress qbar-track h-1.5" data-f="bar-5h-track" max="100" value="0"></progress><span class="qbar-pct shrink-0 font-mono text-xs tabular-nums" data-f="bar-5h-pct"></span><span class="qbar-reset text-xs text-base-content/60 tabular-nums" data-f="bar-5h-reset"></span></div><div class="qbar flex items-center gap-2" data-f="bar-week"><span class="qbar-label shrink-0 text-xs text-base-content/60">周</span><progress class="progress qbar-track h-1.5" data-f="bar-week-track" max="100" value="0"></progress><span class="qbar-pct shrink-0 font-mono text-xs tabular-nums" data-f="bar-week-pct"></span><span class="qbar-reset text-xs text-base-content/60 tabular-nums" data-f="bar-week-reset"></span></div><div class="qbar flex items-center gap-2" data-f="bar-month"><span class="qbar-label shrink-0 text-xs text-base-content/60" data-f="bar-month-label">月</span><progress class="progress qbar-track h-1.5" data-f="bar-month-track" max="100" value="0"></progress><span class="qbar-pct shrink-0 font-mono text-xs tabular-nums" data-f="bar-month-pct"></span><span class="qbar-reset text-xs text-base-content/60 tabular-nums" data-f="bar-month-reset"></span></div><div class="cell-sub aux-text text-xs text-base-content/60" data-f="quota-meta">剩余 <span class="usable-balance tabular-nums" data-f="usable-balance"></span><span data-f="quota-plan"></span></div><div class="cell-sub aux-text text-xs tabular-nums" data-f="credits"></div><div class="cell-error text-error" data-f="error"></div></td><td data-label="状态" data-f="status-cell"><span class="tag badge badge-sm" data-f="status"></span><span class="cell-sub text-xs text-base-content/60 tabular-nums" data-f="status-reset"></span></td><td data-label="操作" class="actions flex flex-wrap gap-1"><button class="btn btn-ghost btn-sm" type="button" data-act="detail" data-f="btn-detail" aria-haspopup="dialog"><Eye size={15} aria-hidden="true" />详情</button><button class="btn btn-outline btn-xs" type="button" data-act="test" data-f="btn-test">测试连通性</button><button class="btn btn-xs" type="button" data-act="toggle" data-f="btn-toggle"></button><button class="btn btn-outline btn-xs" type="button" data-act="rename" data-f="btn-rename">改备注</button><button class="btn btn-error btn-xs" type="button" data-act="del" data-f="btn-del">删除</button></td></tr></template>
<template id="tpl-key-row"><tr><td data-label="名称"><div class="cell-name font-medium" data-f="name"></div></td><td data-label="keyId" class="mono cell-sub text-xs text-base-content/60" data-f="key-id"></td><td data-label="keyPrefix" class="mono cell-sub text-xs text-base-content/60" data-f="key-prefix"></td><td data-label="创建时间" class="cell-sub text-xs text-base-content/60" data-f="created"></td><td data-label="操作" class="actions flex flex-wrap gap-1"><button class="btn btn-error btn-xs" type="button" data-act="delkey" data-f="btn-del">删除</button></td></tr></template>
<template id="tpl-user-row"><tr><td data-label="用户名"><div class="cell-name font-medium"><span data-f="name"></span><span class="tag info" data-f="self"></span></div></td><td data-label="创建时间" class="cell-sub text-xs text-base-content/60" data-f="created"></td><td data-label="操作" class="actions flex flex-wrap gap-1"><button class="btn btn-ghost btn-sm" type="button" data-act="detail" data-f="btn-detail" aria-haspopup="dialog"><Eye size={15} aria-hidden="true" />详情</button><button class="btn btn-outline btn-xs" type="button" data-act="pass" data-f="btn-pass">改密码</button><button class="btn btn-error btn-xs" type="button" data-act="deluser" data-f="btn-del">删除</button></td></tr></template>
<template id="tpl-event"><div class="event flex flex-wrap items-center gap-2"><span class="event-time shrink-0 font-mono text-xs text-base-content/60" data-f="time"></span><span class="event-level shrink-0" data-f="level"><span class="tag badge badge-sm" data-f="badge"></span></span><span class="event-msg min-w-0 flex-1 max-[820px]:basis-full" data-f="msg"></span></div></template>
<template id="tpl-empty-row"><tr><td colspan="5" class="empty text-base-content/60" data-f="empty"></td></tr></template>
<template id="tpl-empty-line"><div class="empty text-base-content/60" data-f="empty"></div></template>

<div class="toast toast-end z-50" id="toast" role="status" aria-live="polite"></div>

<script src="js/admin-utils.js" is:raw></script>
<script src="js/admin-api.js" is:raw></script>
<script src="js/admin-state.js" is:raw></script>
<script src="js/theme.js" is:raw></script>
<script src="js/login-gate.js" is:raw></script>
<script src="js/render-gate.js" is:raw></script>
<script src="js/render-users.js" is:raw></script>
<script src="js/render-accounts-table.js" is:raw></script>
<script src="js/render-keys-table.js" is:raw></script>
<script src="js/logs.js" is:raw></script>
<script src="js/modal.js" is:raw></script>
<script src="js/detail.js" is:raw></script>
