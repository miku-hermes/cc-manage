---
/* 后台：登录门控 + 账号/客户端 key/管理员/运行日志四个管理区。
   视觉与 / 、/trend 同源：daisyUI（drawer + navbar + table + modal + badge + alert）+ Lucide。
   登录门控行为不变：仍是 showGate/showAdmin 切 display，apiJSON 见 401 回登录页。 */
import Layout from '../layouts/Layout.astro';
import AccountDetailModal from '../components/AccountDetailModal.astro';
import AdminSidebar from '../components/AdminSidebar.astro';
import {
  Activity, Moon, Sun, LogOut, ChevronLeft, Menu,
  Plus, RefreshCw, Copy, Lock, Eye,
} from '@lucide/astro';
---
<Layout title="cc-manage · 后台" description="cc-manage 后台：管理 Command Code 账号、API 客户端 key 与管理员账号。">

<div class="header navbar sticky top-0 z-40 min-h-14 border-b border-base-300 bg-base-100/85 backdrop-blur-md" id="gate-head" style="display:none">
  <div class="navbar-start gap-2 px-2">
    <span class="logo text-primary" aria-hidden="true"><Activity size={22} /></span>
    <span class="brand-name text-lg font-bold tracking-tight">cc-manage</span>
    <span class="brand-sub text-sm text-base-content/60">后台</span>
  </div>
  <div class="navbar-end px-2">
    <button id="theme-gate" class="icon-btn btn btn-ghost btn-circle btn-sm" type="button" title="切换主题" aria-label="切换主题">
      <Moon class="ico-moon dark:hidden" size={18} /><Sun class="ico-sun hidden dark:block" size={18} />
    </button>
  </div>
</div>

<main class="gate-main flex min-h-screen items-center justify-center p-4" id="boot-loading">
  <section class="gate-card card w-full max-w-md rounded-[var(--radius-md)] border border-base-300 bg-base-100 shadow-[var(--shadow-card)]">
    <div class="card-body items-center gap-3">
      <span class="loading loading-spinner loading-lg text-primary" aria-hidden="true"></span>
      <div class="skeleton h-4 w-32"></div>
      <h1 class="text-lg font-semibold">加载中…</h1>
      <p class="sub text-sm text-base-content/60">正在确认登录状态…</p>
    </div>
  </section>
</main>

<main class="gate-main flex min-h-screen items-center justify-center p-4" id="gate-main" style="display:none">
  <section class="gate-card card w-full max-w-md rounded-[var(--radius-md)] border border-base-300 bg-base-100 shadow-[var(--shadow-card)]">
    <form id="gate-form" class="card-body gap-3" novalidate>
    <div class="gate-logo mx-auto text-primary" aria-hidden="true"><Lock size={28} /></div>
    <h1 id="gate-title" class="text-center text-xl font-semibold">加载中…</h1>
    <p class="sub text-center text-sm text-base-content/60" id="gate-sub"></p>
    <div class="field space-y-1">
      <label class="label text-sm" for="gate-user">用户名</label>
      <input id="gate-user" class="input input-bordered w-full" type="text" autocomplete="username" spellcheck="false" maxlength="64">
    </div>
    <div class="field space-y-1">
      <label class="label text-sm" for="gate-pass">密码</label>
      <input id="gate-pass" class="input input-bordered w-full" type="password" autocomplete="current-password" spellcheck="false">
    </div>
    <div class="field space-y-1" id="gate-pass2-field" style="display:none">
      <label class="label text-sm" for="gate-pass2">确认密码</label>
      <input id="gate-pass2" class="input input-bordered w-full" type="password" autocomplete="new-password" spellcheck="false">
    </div>
    <div class="gate-actions modal-action justify-between">
      <a class="nav-link btn btn-ghost btn-sm gap-1" href="/"><ChevronLeft size={15} />返回前台</a>
      <button class="btn btn-primary" type="button" id="gate-submit">登录</button>
    </div>
    <div class="gate-err alert alert-error hidden text-sm" id="gate-err" role="alert"></div>
    </form>
  </section>
</main>

<div class="drawer lg:drawer-open" id="admin-shell">
  <input id="admin-drawer" type="checkbox" class="drawer-toggle">

  <div class="drawer-content flex min-h-screen flex-col">
    <header class="header navbar sticky top-0 z-40 min-h-14 border-b border-base-300 bg-base-100/85 backdrop-blur-md" id="admin-head" style="display:none">
      <div class="navbar-start gap-1 px-2">
        <label for="admin-drawer" class="btn btn-ghost btn-circle btn-sm lg:hidden" aria-label="打开菜单"><Menu size={18} /></label>
        <span class="brand-sub text-lg font-bold tracking-tight">控制台</span>
      </div>
      <div class="navbar-end gap-1 px-2">
        <span id="who" class="who text-sm text-base-content/70"></span>
        <a class="nav-link btn btn-ghost btn-sm gap-1" href="/" aria-label="返回前台" title="返回前台"><ChevronLeft size={15} /><span class="nav-label">返回前台</span></a>
        <button id="theme" class="icon-btn btn btn-ghost btn-circle btn-sm tooltip tooltip-bottom" type="button" data-tip="切换主题" title="切换主题" aria-label="切换主题">
          <Moon class="ico-moon dark:hidden" size={18} /><Sun class="ico-sun hidden dark:block" size={18} />
        </button>
        <button id="logout" class="btn btn-ghost btn-sm gap-1" type="button"><LogOut size={15} />退出</button>
      </div>
    </header>

      <main class="admin-main mx-auto flex w-full max-w-6xl flex-col gap-4 p-4 2xl:max-w-[1600px]" id="admin-main" style="display:none">
      <h1 class="sr-only">后台管理</h1>
      <div class="banner warn alert alert-warning hidden" id="public-note" role="status"></div>
      <div class="banner alert alert-error hidden" id="autherr" role="alert"></div>
      <div class="banner load-error alert alert-error hidden" id="load-error" role="alert">
        <span id="load-error-text"></span>
        <button class="btn btn-sm max-[820px]:min-h-9" type="button" id="load-retry">重试</button>
      </div>
      <p class="readonly text-sm text-base-content/60" id="readonly"></p>

      <section class="admin-page admin-page-overview" id="page-overview" aria-hidden="true">
        <h2 class="sr-only">概览</h2>
        <div class="banner alert hidden" id="overview-alert" role="status"></div>

        <div id="overview-kpis" class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="概览 KPI">
          <div class="card border border-base-300 bg-base-100"><div class="card-body gap-1 p-3">
            <span class="text-xs text-base-content/60">今日请求</span>
            <span id="overview-requests" class="text-xl font-semibold tabular-nums">—</span>
            <span id="overview-requests-sub" class="text-xs text-base-content/60"></span>
          </div></div>
          <div class="card border border-base-300 bg-base-100"><div class="card-body gap-1 p-3">
            <span class="text-xs text-base-content/60">错误率</span>
            <span id="overview-error-rate" class="text-xl font-semibold tabular-nums">—</span>
            <span id="overview-error-rate-sub" class="text-xs text-base-content/60"></span>
          </div></div>
          <div class="card border border-base-300 bg-base-100"><div class="card-body gap-1 p-3">
            <span class="text-xs text-base-content/60">今日 token</span>
            <span id="overview-tokens" class="text-xl font-semibold tabular-nums">—</span>
            <span id="overview-tokens-sub" class="text-xs text-base-content/60"></span>
          </div></div>
          <div class="card border border-base-300 bg-base-100"><div class="card-body gap-1 p-3">
            <span class="text-xs text-base-content/60">可用账号</span>
            <span id="overview-accounts-available" class="text-xl font-semibold tabular-nums">—</span>
            <span id="overview-accounts-sub" class="text-xs text-base-content/60"></span>
          </div></div>
        </div>

        <section class="card border border-base-300 bg-base-100" id="sec-overview-accounts">
          <div class="card-body gap-2 p-3">
            <h3 class="card-title text-base">账号池概览</h3>
            <div class="divide-y divide-base-200" id="overview-accounts" aria-label="账号池概览（只读，点击整行进入账号池）"></div>
          </div>
        </section>

        <section class="card border border-base-300 bg-base-100" id="sec-overview-logs">
          <div class="card-body gap-2 p-3">
            <h3 class="card-title text-base">最近请求</h3>
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead><tr><th>时间</th><th>客户端</th><th>模型</th><th>状态</th><th>耗时</th></tr></thead>
                <tbody id="overview-logs"></tbody>
              </table>
            </div>
          </div>
        </section>
      </section>

      <section class="admin-page" id="page-accounts" aria-hidden="true">
        <h2 class="sr-only">账号池</h2>
        <section class="card border border-base-300 bg-base-100" id="sec-accounts">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="card-title text-base">CC 账号 <span class="badge badge-ghost" id="acc-count">0 个</span></h2>
              <button class="btn btn-primary btn-sm gap-1" type="button" id="add-account"><Plus size={15} />新增 CC key</button>
            </div>
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead><tr><th>备注名</th><th>keyId / keyPrefix</th><th>额度</th><th>状态</th><th>操作</th></tr></thead>
                <tbody id="accounts"></tbody>
              </table>
            </div>
          </div>
        </section>
      </section>

      <section class="admin-page" id="page-keys" aria-hidden="true">
        <h2 class="sr-only">客户端密钥</h2>
        <section class="card border border-base-300 bg-base-100" id="sec-keys">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="card-title text-base">客户端 key <span class="badge badge-ghost" id="key-count">0 个</span></h2>
              <button class="btn btn-primary btn-sm gap-1" type="button" id="add-key"><Plus size={15} />生成新 key</button>
            </div>
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead><tr><th>名称</th><th>keyPrefix</th><th>状态</th><th>用量</th><th>过期时间</th><th>备注</th><th>操作</th></tr></thead>
                <tbody id="keys"></tbody>
              </table>
            </div>
          </div>
        </section>
      </section>

      <section class="admin-page" id="page-users" aria-hidden="true">
        <h2 class="sr-only">管理员</h2>
        <section class="card border border-base-300 bg-base-100" id="sec-users">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="card-title text-base">管理员 <span class="badge badge-ghost" id="user-count">0 个</span></h2>
              <button class="btn btn-primary btn-sm gap-1" type="button" id="add-user"><Plus size={15} />新增管理员</button>
            </div>
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead><tr><th>用户名</th><th>创建时间</th><th>操作</th></tr></thead>
                <tbody id="users"></tbody>
              </table>
            </div>
          </div>
        </section>
      </section>

      <section class="admin-page admin-page-audit" id="page-audit" aria-hidden="true">
        <h2 class="sr-only">审计日志</h2>
        <div class="banner alert alert-warning hidden" id="audit-degraded" role="status">台账写入失败，已在内存中保留</div>
        <section class="card border border-base-300 bg-base-100" id="sec-audit">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="card-title text-base">审计日志 <span class="badge badge-ghost" id="audit-count">0 条</span></h3>
              <div class="join">
                <select id="audit-action" class="select select-bordered select-sm join-item max-[820px]:min-h-9" aria-label="按操作过滤">
                  <option value="">全部操作</option>
                </select>
                <input id="audit-q" class="input input-bordered input-sm join-item max-[820px]:min-h-9" type="text" placeholder="搜索操作者 / 对象 / 内容" aria-label="搜索操作者 / 对象 / 内容" autocomplete="off" spellcheck="false">
                <button id="reload-audit" class="btn btn-sm join-item" type="button"><RefreshCw size={14} aria-hidden="true" />刷新</button>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead><tr><th>时间</th><th>操作者</th><th>操作</th><th>对象</th><th>详情</th><th>IP</th></tr></thead>
                <tbody id="audit-body"><tr><td colspan="6" class="empty text-base-content/60">暂无审计记录</td></tr></tbody>
              </table>
            </div>
          </div>
        </section>
      </section>

      <section class="admin-page" id="page-events" aria-hidden="true">
        <h2 class="sr-only">运行日志</h2>
        <section class="card border border-base-300 bg-base-100" id="sec-events">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="card-title text-base">运行日志 <span class="badge badge-ghost" id="event-count">0 条</span></h2>
              <div class="join">
                <select id="level" class="select select-bordered select-sm join-item max-[820px]:min-h-9" aria-label="按级别过滤">
                  <option value="">全部级别</option>
                  <option value="info">info</option>
                  <option value="warn">warn</option>
                  <option value="error">error</option>
                  <option value="debug">debug</option>
                </select>
                <button class="btn btn-sm join-item gap-1" type="button" id="reload-events"><RefreshCw size={14} />刷新</button>
              </div>
            </div>
            <div class="events divide-y divide-base-200" id="events" aria-live="polite"></div>
          </div>
        </section>
      </section>

      <section class="admin-page" id="page-logs" aria-hidden="true">
        <h2 class="sr-only">请求日志</h2>
        <div class="banner alert alert-error hidden" id="logs-dropped" role="alert"></div>
        <section class="card border border-base-300 bg-base-100" id="sec-logs">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="card-title text-base">请求日志 <span class="badge badge-ghost" id="logs-count">0 条</span></h3>
              <div class="flex flex-wrap items-center gap-1">
                <select id="logs-key" class="select select-bordered select-sm max-[820px]:min-h-9" aria-label="按客户端过滤">
                  <option value="">全部客户端</option>
                </select>
                <select id="logs-status" class="select select-bordered select-sm max-[820px]:min-h-9" aria-label="按状态过滤">
                  <option value="">全部状态</option>
                  <option value="ok">成功</option>
                  <option value="error">失败</option>
                </select>
                <input id="logs-model" class="input input-bordered input-sm w-32 max-[820px]:min-h-9" type="text" placeholder="模型" aria-label="按模型过滤" autocomplete="off" spellcheck="false">
                <input id="logs-q" class="input input-bordered input-sm w-32 max-[820px]:min-h-9" type="text" placeholder="关键字" aria-label="按关键字过滤" autocomplete="off" spellcheck="false">
                <button id="logs-refresh" class="btn btn-sm gap-1 max-[820px]:min-h-9" type="button"><RefreshCw size={14} aria-hidden="true" />刷新</button>
              </div>
            </div>
            <div class="overflow-x-auto">
              <table class="table table-sm">
                <thead><tr><th>时间</th><th>客户端</th><th>账号</th><th>模型</th><th>状态</th><th>耗时</th><th>入 token</th><th>出 token</th></tr></thead>
                <tbody id="logs"></tbody>
              </table>
            </div>
            <div class="flex justify-center">
              <button id="logs-more" class="btn btn-outline btn-sm hidden" type="button">加载更多</button>
            </div>
          </div>
        </section>
      </section>

      <section class="admin-page" id="page-usage" aria-hidden="true">
        <h2 class="sr-only">用量统计</h2>
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="card-title text-base">用量统计</h3>
          <div class="tabs tabs-box tabs-sm border border-base-300 bg-base-200/60" role="tablist" aria-label="统计范围" id="usage-range">
            <button class="tab tab-active text-primary" type="button" role="tab" aria-selected="true" data-range="24h">24 小时</button>
            <button class="tab text-base-content/70 hover:text-primary" type="button" role="tab" aria-selected="false" data-range="7d">7 天</button>
            <button class="tab text-base-content/70 hover:text-primary" type="button" role="tab" aria-selected="false" data-range="30d">30 天</button>
          </div>
        </div>
        <div id="usage-kpis" class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="用量 KPI"></div>
        <div class="overflow-x-auto"><div id="usage-chart" style="height:280px"></div></div>
        <div id="usage-tables" class="flex flex-wrap gap-3"></div>
      </section>

      <section class="admin-page admin-page-settings" id="page-settings" aria-hidden="true">
        <h2 class="sr-only">系统设置</h2>
        <div class="banner alert alert-error hidden" id="settings-err" role="alert"></div>
        <section class="card border border-base-300 bg-base-100" id="sec-settings">
          <div class="card-body gap-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="card-title text-base">系统设置</h3>
              <span class="text-xs text-base-content/60">保存后立即写入 config.json（写前会留一份 .bak；目录不可写时自动跳过备份）</span>
            </div>
            <div class="divide-y divide-base-200" id="settings-list">
              <div class="setting-row flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <span class="block text-sm font-medium" id="set-label-requestLogEnabled">请求日志</span>
                  <span class="block text-xs text-base-content/60">记录每次 /v1 请求的明细（时间 / 客户端 / 账号 / 模型 / 状态 / 耗时 / token）。</span>
                </div>
                <div class="setting-ctl flex shrink-0 items-center gap-2">
                  <span class="setting-current text-xs tabular-nums text-base-content/60" data-current="requestLogEnabled">—</span>
                  <input id="set-requestLogEnabled" data-setting="requestLogEnabled" class="toggle toggle-primary" type="checkbox" aria-labelledby="set-label-requestLogEnabled">
                </div>
              </div>
              <div class="setting-row flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <span class="block text-sm font-medium" id="set-label-requestLogRetentionDays">日志保留天数</span>
                  <span class="block text-xs text-base-content/60">超过天数的请求日志文件会被清理（1–365 天）。</span>
                </div>
                <div class="setting-ctl flex shrink-0 items-center gap-2">
                  <span class="setting-current text-xs tabular-nums text-base-content/60" data-current="requestLogRetentionDays">—</span>
                  <input id="set-requestLogRetentionDays" data-setting="requestLogRetentionDays" class="input input-bordered input-sm w-28 tabular-nums max-[820px]:min-h-9" type="number" min="1" max="365" step="1" inputmode="numeric" aria-labelledby="set-label-requestLogRetentionDays">
                </div>
              </div>
              <div class="setting-row flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <span class="block text-sm font-medium" id="set-label-requestLogMaxMb">单个日志文件上限</span>
                  <span class="block text-xs text-base-content/60">单日日志文件超过上限后丢弃后续条目，单位 MB（1–1024）。</span>
                </div>
                <div class="setting-ctl flex shrink-0 items-center gap-2">
                  <span class="setting-current text-xs tabular-nums text-base-content/60" data-current="requestLogMaxMb">—</span>
                  <input id="set-requestLogMaxMb" data-setting="requestLogMaxMb" class="input input-bordered input-sm w-28 tabular-nums max-[820px]:min-h-9" type="number" min="1" max="1024" step="1" inputmode="numeric" aria-labelledby="set-label-requestLogMaxMb">
                </div>
              </div>
              <div class="setting-row flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <span class="block text-sm font-medium" id="set-label-publicDashboard">前台面板公开只读</span>
                  <span class="block text-xs text-base-content/60">关闭后 /、/trend 与前台的 /api/status 都需要登录后台才能查看。</span>
                </div>
                <div class="setting-ctl flex shrink-0 items-center gap-2">
                  <span class="setting-current text-xs tabular-nums text-base-content/60" data-current="publicDashboard">—</span>
                  <input id="set-publicDashboard" data-setting="publicDashboard" class="toggle toggle-primary" type="checkbox" aria-labelledby="set-label-publicDashboard">
                </div>
              </div>
              <div class="setting-row flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <span class="block text-sm font-medium" id="set-label-quotaPollIntervalMs">空闲期额度轮询间隔</span>
                  <span class="block text-xs text-base-content/60">最近没有代理请求时，多久查一轮上游额度，单位毫秒（5000–3600000）。</span>
                </div>
                <div class="setting-ctl flex shrink-0 items-center gap-2">
                  <span class="setting-current text-xs tabular-nums text-base-content/60" data-current="quotaPollIntervalMs">—</span>
                  <input id="set-quotaPollIntervalMs" data-setting="quotaPollIntervalMs" class="input input-bordered input-sm w-32 tabular-nums max-[820px]:min-h-9" type="number" min="5000" max="3600000" step="1000" inputmode="numeric" aria-labelledby="set-label-quotaPollIntervalMs">
                </div>
              </div>
              <div class="setting-row flex items-center justify-between gap-3 py-3">
                <div class="min-w-0">
                  <span class="block text-sm font-medium" id="set-label-quotaActivePollIntervalMs">活跃期额度轮询间隔</span>
                  <span class="block text-xs text-base-content/60">最近有代理请求时改用这个间隔查上游额度，单位毫秒（5000–3600000）。</span>
                </div>
                <div class="setting-ctl flex shrink-0 items-center gap-2">
                  <span class="setting-current text-xs tabular-nums text-base-content/60" data-current="quotaActivePollIntervalMs">—</span>
