---
import SiteHeader from '../components/SiteHeader.astro';
import TrendCard from '../components/TrendCard.astro';

/* 与 index 同源的 color-scheme 分派（B2-13 契约：内联 <style> 里保留）。 */
const styleTag = `<style>
  :root { color-scheme: light dark; }
  :root[data-theme="light"] { color-scheme: light; }
  :root[data-theme="dark"] { color-scheme: dark; }
</style>`;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>cc-manage · 近 24 小时趋势</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20fill='%23e8668a'%20d='M12%202.6l2.5%206.2%206.2%202.5-6.2%202.5-2.5%206.2-2.5-6.2L3.3%2011.3l6.2-2.5z'/%3E%3C/svg%3E">
<meta name="description" content="cc-manage 近 24 小时趋势：请求数 / 错误数 / 可用余额的 ECharts 折线图。">
<Fragment set:html={styleTag} />
<script is:raw>
try {
  var t = localStorage.getItem('cc-manage-theme');
  if (t === 'light' || t === 'dark') {
    document.documentElement.setAttribute('data-theme', t);
  } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
    document.documentElement.setAttribute('data-theme', 'dark');
  }
} catch (e) { /* 忽略 */ }
</script>
<link rel="stylesheet" href="css/tokens.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/dashboard.css">
</head>
<body>
<div class="petals" id="petals" aria-hidden="true"></div>

<SiteHeader search={false} />

<main>
  <p class="trend-back"><a href="/">← 返回面板</a></p>
  <TrendCard />
</main>

<script src="js/utils.js" is:raw></script>
<script src="js/api.js" is:raw></script>
<script src="js/theme.js" is:raw></script>
<script src="js/render-trend.js" is:raw></script>
<script is:raw>
/* 趋势页引导：只加载趋势相关资源（不引 render-hero/render-cards/app）。
   vendor/echarts.min.js 由 render-trend.js 在首次真正渲染时懒加载。 */
document.addEventListener('click', (e) => {
  const t = e.target;
  if (t && t.closest && t.closest('#theme')) { setTheme(currentTheme() === 'dark' ? 'light' : 'dark'); return; }
});
function bootTrendPage() {
  loadTrend();
  setInterval(() => { if (!document.hidden) loadTrend(); }, 60000);
}
bootTrendPage();
</script>
</body>
</html>
