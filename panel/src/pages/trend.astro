---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TrendCard from '../components/TrendCard.astro';
import { ChevronLeft } from '@lucide/astro';
---
<Layout title="cc-manage · 近 24 小时趋势" description="cc-manage 近 24 小时趋势：请求数 / 错误数 / 可用余额的 ECharts 折线图。">
<SiteHeader search={false} />

<main class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-4 py-4 2xl:max-w-[1600px]">
  <p class="trend-back"><a class="btn btn-ghost btn-sm gap-1" href="/"><ChevronLeft size={15} />返回面板</a></p>
  <TrendCard />
</main>

<script src="js/utils.js" is:raw></script>
<script src="js/api.js" is:raw></script>
<script src="js/theme.js" is:raw></script>
<script src="js/render-trend.js" is:raw></script>
<script is:raw>
/* 趋势页引导：只加载趋势相关资源（不引 render-hero/render-cards/app）。
   vendor/echarts.min.js 由 render-trend.js 在首次真正渲染时懒加载。 */
document.addEventListener('click', (e) => {
  const t = e.target;
  if (t && t.closest && t.closest('#theme')) { setTheme(currentTheme() === 'dark' ? 'light' : 'dark'); return; }
});
function bootTrendPage() {
  loadTrend();
  setInterval(() => { if (!document.hidden) loadTrend(); }, 60000);
}
bootTrendPage();
</script>
</Layout>
