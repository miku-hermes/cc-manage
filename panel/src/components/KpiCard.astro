---
/* KPI 卡（daisyUI stat）：结构只在这里出现一次，index.astro 用它产出 <template id="tpl-kpi">。
   三个 Lucide 图标都放在模板里，JS 只切换 hidden —— 不需要任何 HTML 字符串。 */
import { Activity, TriangleAlert, Pause } from '@lucide/astro';
---
<div class="kpi stat bg-base-100">
  <div class="kpi-head stat-title flex items-center gap-1.5">
    <span class="kpi-icon text-base-content/50" aria-hidden="true">
      <Activity data-f="kpi-icon-total" size={14} />
      <TriangleAlert data-f="kpi-icon-errors" size={14} hidden />
      <Pause data-f="kpi-icon-paused" size={14} hidden />
    </span>
    <span class="kpi-label" data-f="kpi-label"></span>
  </div>
  <b class="stat-value text-2xl" data-f="kpi-value"></b>
  <small class="kpi-sub stat-desc text-base-content/60" data-f="kpi-sub"></small>
</div>
