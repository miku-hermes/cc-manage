---
/* 欢迎横幅（参考主题的 hero 区）：左侧看板娘 + 问候 + 网关状态；右侧日期 + 数码时钟 + 累计 token；
   中段是余额主角（大数字 + 本月额度环形进度 + 构成明细）；底部是元信息与操作。
   所有 id 沿用旧契约（greeting/date/balance/bal-label/bal-breakdown/usage-gauge/health/upstream/
   updated/cadence/tokens/refresh-quota），render-hero.js 无需改填充逻辑。 */
import StatusPill from './StatusPill.astro';
import { RefreshCw, TrendingUp, ChevronRight } from '@lucide/astro';
---
<section class="hero-banner card border border-base-300 bg-base-100 transition-[box-shadow,transform,background-color]">
  <div class="hero-deco" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>

  <div class="hero-banner-top">
    <div class="hero-ident">
      <img class="hero-mascot" src="/img/QWQ.webp" alt="" width="360" height="360" decoding="async">
      <div class="hero-greet">
        <h1 id="greeting" class="greeting">下午好</h1>
        <p class="hero-sub"><span class="hero-sub-label">网关<span class="hero-sub-label-rest">状态</span></span><StatusPill variant="health" id="health" /></p>
      </div>
    </div>

    <div class="hero-clock-box">
      <div id="clock" class="hero-clock tabular-nums">--:--:--</div>
      <div id="date" class="hero-date"></div>
      <div class="hero-tokens aux-text">累计 token <b id="tokens" class="tabular-nums">0</b></div>
    </div>
  </div>

  <div class="hero-banner-mid">
    <!-- 值 + 图同行（KPI 卡的通行排法）：窄屏下环若单独占一行，右侧会空掉半行，
         且环紧贴「额度构成」下方容易被读成同一组数据。环靠右与余额同排即可消掉这两点。 -->
    <div class="hero-row-main">
      <div class="hero-balance">
        <b id="balance" class="tabular-nums">—</b>
        <span id="bal-label" class="bal-label aux-text">剩余额度（USD）</span>
      </div>
      <!-- 环缩小成小圆环当指示器，数值放到环外：○ 本月已用 68.5% -->
      <div class="hero-gauge" role="group" aria-label="本月额度用量">
        <span id="usage-gauge" class="radial-progress text-primary" style="--value:0" role="progressbar" aria-label="本月额度已用 0.0%"></span>
        <span id="gauge-cap" class="hero-gauge-cap aux-text">本月已用</span>
        <span id="gauge-pct" class="hero-gauge-pct tabular-nums">—</span>
      </div>
    </div>
    <!-- 额度构成独立一行、由标题领起：以前它和「本月已用」用 `·` 并列，读者会把构成金额读成「本月已用金额」。 -->
    <div class="hero-compose">
      <span class="hero-compose-cap aux-text">额度构成</span>
      <p id="bal-breakdown" class="hero-breakdown tabular-nums"></p>
    </div>
  </div>

  <div class="hero-banner-foot">
    <p class="hero-meta aux-text">
      <span id="upstream"></span><span id="updated" class="tabular-nums"></span><span id="cadence" class="hero-cadence"></span>
    </p>
    <div class="hero-actions flex-wrap">
      <button id="refresh-quota" class="btn btn-primary btn-sm gap-1" type="button"><RefreshCw size={15} />刷新额度</button>
      <a class="trend-link btn btn-ghost btn-sm gap-1" href="/trend" aria-label="查看近 24 小时趋势">
        <TrendingUp size={15} />近 24 小时趋势<ChevronRight size={14} />
      </a>
    </div>
  </div>
</section>
