---
/* 状态胶囊（daisyUI badge）。variant="health"：Hero 的网关状态，role=status / aria-live=polite。
   默认 variant="status"：账号行右侧状态徽章，结构里只留 aria-hidden 的色点，文案由 JS 追加。 */
const { variant = 'status', id = '', text = '加载中…' } = Astro.props;
---
{variant === 'health' ? (
  <span id={id} class="pill badge badge-ghost" role="status" aria-live="polite">{text}</span>
) : (
  <span class="status badge badge-ghost" data-f="account-status"><span class="dot" aria-hidden="true"></span></span>
)}
