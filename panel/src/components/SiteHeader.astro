---
/* 站点头部：daisyUI navbar + Lucide 图标。search=false 时（趋势页）不渲染搜索框。 */
import { Search, Moon, Sun, Lock, Activity } from '@lucide/astro';
const { search = true } = Astro.props;
---
<header class="header navbar sticky top-0 z-30 min-h-12 border-b border-base-300 bg-base-100/85 backdrop-blur-md">
  <div class="navbar-start gap-2 px-2">
    <span class="logo text-primary" aria-hidden="true"><Activity size={22} /></span>
    <span class="brand-name text-lg font-bold tracking-tight">cc-manage</span>
  </div>
  <div class="navbar-end tools flex items-center gap-1 px-2">
    {search && (
      <label class="search-box input input-sm flex w-9 items-center gap-2 overflow-hidden px-2 transition-[width] duration-200 [&.expanded]:w-44 focus-within:w-44 max-sm:w-8 max-[340px]:[&.expanded]:w-28 max-[340px]:focus-within:w-28">
        <Search size={15} aria-hidden="true" class="shrink-0" />
        <input id="search" type="search" class="min-w-0 grow bg-transparent text-sm" placeholder="搜索账号" aria-label="搜索账号" autocomplete="off">
      </label>
    )}
    <button id="theme" class="icon-btn btn btn-ghost btn-circle btn-sm tooltip tooltip-bottom" type="button" data-tip="切换主题" title="切换主题" aria-label="切换主题">
      <Moon class="ico-moon dark:hidden" size={18} />
      <Sun class="ico-sun hidden dark:block" size={18} />
    </button>
    <a class="admin-link btn btn-ghost btn-circle btn-sm tooltip tooltip-bottom" href="/admin" data-tip="登录后台" aria-label="登录后台" title="账号密码登录后台，管理 CC key 与客户端 key">
      <Lock size={18} />
    </a>
    <span id="keyhint" class="hint text-xs text-base-content/60"></span>
  </div>
</header>
