---
/* 站点头部：品牌 + 搜索 + 视图切换（网格/列表）+ 主题 + 后台入口。
   search=false 时（趋势页）不渲染搜索框；viewSwitch=false 时（趋势/后台页）不渲染视图切换。 */
import { Search, Moon, Sun, Lock, Activity, LayoutGrid, List } from '@lucide/astro';
const { search = true, viewSwitch = false, view = 'grid' } = Astro.props;
---
<header class="header navbar sticky top-0 z-30 min-h-14 border-b border-base-300 bg-base-100/95 backdrop-blur-md shadow-sm p-0">
  <div class="navbar-row mx-auto flex w-full max-w-6xl items-center px-4 2xl:max-w-[1600px]">
  <div class="navbar-start gap-2 px-0">
    <span class="logo text-primary" aria-hidden="true"><Activity size={22} /></span>
    <span class="brand-name text-lg font-bold tracking-tight">cc-manage</span>
  </div>
  <div class="navbar-end tools flex items-center gap-1 px-2">
    {search && (
      <label class="search-box input input-sm flex w-9 items-center gap-2 overflow-hidden px-2 transition-[width] duration-(--dur-fast) [&.expanded]:w-44 focus-within:w-44 max-sm:w-8 max-[340px]:[&.expanded]:w-28 max-[340px]:focus-within:w-28">
        <Search size={15} aria-hidden="true" class="shrink-0" />
        <input id="search" type="search" class="min-w-0 grow bg-transparent text-sm" placeholder="搜索账号" aria-label="搜索账号" autocomplete="off">
      </label>
    )}
    {viewSwitch && (
      <div class="view-switch join" role="group" aria-label="视图切换">
        <button id="view-grid" class:list={['view-btn', 'btn', 'btn-sm', 'join-item', view === 'grid' && 'is-active']} type="button" data-view="grid" title="网格视图" aria-label="网格视图" aria-pressed={view === 'grid' ? 'true' : 'false'}>
          <LayoutGrid size={16} />
        </button>
        <button id="view-list" class:list={['view-btn', 'btn', 'btn-sm', 'join-item', view === 'list' && 'is-active']} type="button" data-view="list" title="列表视图" aria-label="列表视图" aria-pressed={view === 'list' ? 'true' : 'false'}>
          <List size={16} />
        </button>
      </div>
    )}
    <button id="theme" class="icon-btn btn btn-ghost btn-circle btn-sm tooltip tooltip-bottom" type="button" data-tip="切换主题" title="切换主题" aria-label="切换主题">
      <Moon class="ico-moon dark:hidden" size={18} />
      <Sun class="ico-sun hidden dark:block" size={18} />
    </button>
    <a class="admin-link btn btn-ghost btn-circle btn-sm tooltip tooltip-bottom" href="/admin" data-tip="登录后台" aria-label="登录后台" title="账号密码登录后台，管理 CC key 与客户端 key">
      <Lock size={18} />
    </a>
    <span id="keyhint" class="hint text-xs aux-text"></span>
  </div>
  </div>
</header>
