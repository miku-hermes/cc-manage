---
/* 账号行（daisyUI collapse，行式：默认只显示摘要，点开看明细）。
   结构只在这里出现一次（index.astro 产出 <template id="tpl-account">）。
   可变文本全部由 render-cards.js 用 textContent 填；没有数据的区块 JS 直接 remove。 */
import CreditsBar from './CreditsBar.astro';
import StatusPill from './StatusPill.astro';
---
<details class="card row-card collapse collapse-arrow border border-base-300 bg-base-100 transition-colors">
  <!-- B24e：名称列 minmax(0,max-content) 按内容自适应（宽度 = 名字实际需要，不钉死像素），
       多出来的宽度全给右侧米数（1fr 右对齐）。名称列够宽时 h2 不裁剪；真不够时才省略。 -->
  <summary class="collapse-title row-summary grid grid-cols-[minmax(0,max-content)_minmax(0,1fr)] items-center gap-x-3 gap-y-1 max-sm:grid-cols-1" aria-expanded="false">
    <span class="row-title flex min-w-0 items-center gap-2">
      <h2 class="card-head truncate text-base font-semibold" data-f="account-head"></h2>
      <StatusPill />
    </span>
    <span class="row-meters flex items-center justify-end gap-3 max-sm:justify-start">
      <span class="card-fresh aux-text text-xs text-base-content/60" data-f="card-fresh"></span>
      <b class="usable-balance text-lg font-bold tabular-nums" data-f="usable-balance"></b>
    </span>
    <!-- 补充标签条移进 summary（原来挂在 .collapse 网格第 3 行会跑到行外）：
         固定在 1.5rem 高，无论有没有徽章，4 行高度都一致。 -->
    <div class="tags col-span-full mt-0.5 flex min-h-6 flex-wrap items-center gap-1 max-sm:flex-nowrap max-sm:overflow-x-auto max-sm:[&.is-scrollable]:mask-fade-x max-sm:[&.at-end]:mask-fade-x-none max-sm:scrollbar-thin-x" data-f="tags"></div>
  </summary>
  <div class="collapse-content card-body gap-3 pt-0">
    <div class="credits-block space-y-1.5" data-f="credits-block">
      <div class="credits-title text-xs text-base-content/60">额度构成</div>
      <CreditsBar />
      <div class="card-credits aux-text text-xs text-base-content/60" data-f="credits-legend"></div>
    </div>
    <div class="bars grid gap-2 @md:grid-cols-3">
      <div class="bar-group space-y-1" role="group" data-f="bar-5h">
        <div class="bar-head flex items-center justify-between gap-2 text-xs">
          <span class="bar-label">5 小时窗口</span>
          <span class="bar-tail flex items-center gap-2 text-base-content/60"><span class="bar-pct font-mono" data-f="bar-5h-pct"></span><span class="bar-reset" data-f="bar-5h-reset"></span></span>
        </div>
        <progress class="progress bar h-1.5 w-full" max="100" value="0" data-f="bar-5h-track"></progress>
      </div>
      <div class="bar-group space-y-1" role="group" data-f="bar-week">
        <div class="bar-head flex items-center justify-between gap-2 text-xs">
          <span class="bar-label">本周窗口</span>
          <span class="bar-tail flex items-center gap-2 text-base-content/60"><span class="bar-pct font-mono" data-f="bar-week-pct"></span><span class="bar-reset" data-f="bar-week-reset"></span></span>
        </div>
        <progress class="progress bar h-1.5 w-full" max="100" value="0" data-f="bar-week-track"></progress>
      </div>
      <div class="bar-group space-y-1" role="group" data-f="bar-month">
        <div class="bar-head flex items-center justify-between gap-2 text-xs">
          <span class="bar-label">本月周期</span>
          <span class="bar-tail flex items-center gap-2 text-base-content/60"><span class="bar-pct font-mono" data-f="bar-month-pct"></span><span class="bar-reset" data-f="bar-month-reset"></span></span>
        </div>
        <progress class="progress bar h-1.5 w-full" max="100" value="0" data-f="bar-month-track"></progress>
      </div>
    </div>
    <div class="card-usage aux-text text-xs text-base-content/60" data-f="card-usage"></div>
  </div>
</details>
