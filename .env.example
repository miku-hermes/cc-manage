# 宿主侧监听端口（仅绑 127.0.0.1）
GATEWAY_BIND_PORT=3051
# 上游地址
CC_API_BASE=https://api.commandcode.ai
# 前台只读面板是否公开（1=公开只读，0=需要登录后台才能看；默认 1）
PUBLIC_DASHBOARD=1
# 面板可见性只有这一个开关：0 = / 与 /api/status 都要先登录后台（旧版「面板再要一个本地 key」
# 的做法已彻底移除，前台没有 key 输入框，也不把凭证写进浏览器存储）
# 后台管理员账号在首次访问 /admin 时初始化，密码哈希落在 config/users.json；
# cookie 签名密钥自动生成在 config/session-secret（0600）。
# 额度轮询间隔（毫秒）：空闲间隔，设 0 完全关闭轮询
QUOTA_POLL_INTERVAL_MS=600000
# 最近 5 分钟内有代理请求时改用的活跃间隔（毫秒）；设 0 退化为纯空闲间隔
QUOTA_ACTIVE_POLL_INTERVAL_MS=60000
# 判定「活跃」的时间窗（毫秒）
QUOTA_ACTIVE_WINDOW_MS=300000
# 登录限速：每来源每分钟尝试数；全局每分钟总尝试数（0=按实测 scrypt 吞吐自动校准，默认 90）
# LOGIN_ATTEMPTS_PER_MINUTE=60
# LOGIN_GLOBAL_ATTEMPTS_PER_MINUTE=0
# scrypt 串行队列深度上限（含正在执行的一次）；超限直接 503「服务器繁忙」，不排队
# SCRYPT_MAX_QUEUE=8
# 请求体整体读取期限（毫秒）：客户端发到一半停住 → 中止转发并回 408
# BODY_READ_TIMEOUT_MS=120000
# Node server 收完整请求的总时限（毫秒；显式设置，不用 Node 默认的 300s）
# REQUEST_TIMEOUT_MS=180000
# Node server 并发连接上限（默认 512）
# MAX_CONNECTIONS=512
# 网关 keep-alive 超时（毫秒，反代 upstream keepalive_timeout 必须更小）
# KEEPALIVE_TIMEOUT_MS=65000
# 内核限流（小内存机器必调）
CC_MAX_BODY_MB=20
CC_MAX_INFLIGHT=8
# 网关内存预算（compose 里 gateway 的 mem_limit=384m 就是按这条算式定的）：
#   NODE_OPTIONS=--max-old-space-size=192    → 192MB V8 堆上限
#   网关 maxBodyBytes(8MB) × maxInflight(8)  → 最坏 64MB 堆外 Buffer（Buffer 不占堆上限）
#   + SSE/流式响应缓冲、socket、模块与运行时开销
#   余量不足会在并发大上传时被 OOM kill，所以 mem_limit 必须明显高于 192+64。
# 注意网关自己的 MAX_BODY_BYTES / MAX_INFLIGHT 调大会同步抬高上限，改了要一起调 mem_limit。
LOG_LEVEL=info
