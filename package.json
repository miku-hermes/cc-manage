{
  "name": "cc-manage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Command Code 多账号反代网关：额度感知调度 + 只读面板 + Docker 一键部署（后端零构建依赖；面板趋势图使用 ECharts 6.1.0）",
  "main": "gateway.mjs",
  "scripts": {
    "start": "node gateway.mjs",
    "dev": "node --watch gateway.mjs",
    "test": "node --test --test-timeout=150000 --test-concurrency=8 test/*.test.mjs && npm --prefix vendor/commandcode-proxy test",
    "lint": "node scripts/lint.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
